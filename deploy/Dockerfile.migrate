# The Helm chart's migration Job image (#34/#48): the dexaflow-migrate wrapper
# (cmd/dexaflow-migrate) plus the Dexaflow SQL migrations. Run as:
#   dexaflow-migrate -path /migrations -database <url> up
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.migrate -t dexaflow-migrate .
#
# ── What the binary is (#1020) ─────────────────────────────────────────────
#
# It used to be golang-migrate's own `cmd/migrate`, compiled from the version
# in our go.mod (#1039). That CLI printed the raw driver error, so a fresh
# install against a database that does not exist failed with `pq: database "x"
# does not exist` and nothing about database.url, and it linked lib/pq while
# the control plane uses pgx. The wrapper calls golang-migrate's library API
# over pgx v5, maps each driver error to a message in the chart's terms, and
# exits with a code of its own for each failure a retry cannot fix, which the
# migration Job's podFailurePolicy acts on. Its subcommands and flags are the
# golang-migrate CLI's that the docs name (`up`, `version`, `force N`,
# `goto N`, `-path`, `-database`), so the Job's args and the upgrade guide's
# recovery steps are unchanged.
#
# It is one of this module's own packages, so `govulncheck ./...` in
# security.yaml analyses exactly what this stage builds, and no build tag
# selects its database driver: the pgx5 driver is imported by
# internal/migrator, not registered behind `-tags`.
# scripts/check-migrate-cli-build-tags.sh keeps those facts true.

# Pinned to the toolchain CI uses (GO_VERSION in .github/workflows/security.yaml
# and image-scan.yaml). Not cosmetic: Trivy keys `stdlib` findings to the Go
# toolchain recorded in the binary's build info, so a floating tag here would
# move this image's reported vulnerability set for reasons unrelated to any
# commit, the same trap security.yaml documents for dexaflow-server.
ARG GO_VERSION=1.26.10

# Build on the NATIVE platform and cross-compile with GOARCH, rather than
# letting buildx emulate the build stage under QEMU for the arm64 leg. The
# output is a CGO-free static binary either way, so nothing from this stage
# reaches the published image; bookworm vs trixie here changes the build
# environment only, exactly as runtime/Dockerfile's agent stage explains.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src

# Module downloads first, so the cache survives source edits.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETARCH
# VERSION and GIT_COMMIT are stamped into internal/version, the same way
# deploy/Dockerfile.server stamps the server, so `-version` names the build.
# The golang-migrate version is read from the binary's build info at run time.
#
# TARGETARCH is filled in by BuildKit; the fallback keeps a build under any
# front end that leaves it empty from setting GOARCH to the empty string, which
# is not the same thing as leaving it unset.
ARG VERSION=dev
ARG GIT_COMMIT=none
RUN set -eux; \
	CGO_ENABLED=0 GOOS=linux GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath \
		-ldflags="-s -w -X github.com/dexadata/dexaflow/internal/version.version=${VERSION} -X github.com/dexadata/dexaflow/internal/version.gitCommit=${GIT_COMMIT}" \
		-o /out/dexaflow-migrate ./cmd/dexaflow-migrate

# Distroless static, Debian 13 (trixie): the same base as leoflow-server
# (#1400) and the suite runtime/Dockerfile moved to in #1038.
#
# It carries a CA bundle, /etc/passwd with the nonroot user, and six base
# packages (base-files, ca-certificates, media-types, netbase, tzdata,
# tzdata-legacy). No shell and no package manager, so nothing an operator can
# exec into and no application package set — but "no OS packages" would be
# false, and the difference matters for the blocking gate: a fixable HIGH in
# ca-certificates or tzdata reddens it and no commit here closes it. That is a
# six-package exposure instead of Alpine's full set, and .trivyignore.yaml's
# dated, self-expiring entries are what handle it — see security.yaml.
#
# The CA bundle is what makes `sslmode=verify-full` work against a managed
# Postgres whose CA is already in the system store. A DSN with an explicit
# `sslrootcert=` path needs that file mounted instead, and the chart now mounts
# `database.caConfigMap` here as well as in the control plane (#1052) — it did
# not, which broke the chart's own recipe against RDS and Cloud SQL.
#
# The wrapper checks that the sslrootcert file exists before it dials and names
# database.caConfigMap when it does not. It runs on pgx like the control plane,
# so `sslrootcert=system` works in both.
FROM gcr.io/distroless/static-debian13:nonroot

LABEL org.opencontainers.image.source="https://github.com/dexadata/dexaflow"
LABEL org.opencontainers.image.description="dexaflow-migrate plus the Dexaflow SQL migrations, for the Helm migration Job"
LABEL org.opencontainers.image.licenses="Apache-2.0"

COPY --from=build /out/dexaflow-migrate /usr/local/bin/dexaflow-migrate
# The binary embeds the same files and uses them when no -path is given. The
# copy at /migrations stays because the Job, docker-compose and the upgrade
# guide's one-off pods pass `-path=/migrations`. Only the SQL: migrations/ also
# holds embed.go, latest.go and their tests, and shipping source into a
# runtime image is not a thing to leave harmless on purpose.
COPY migrations/*.sql /migrations/

# 65532 numerically, not `nonroot` by name: a PodSecurity `restricted` namespace
# verifies runAsNonRoot against the image's user and the kubelet can only
# resolve a numeric UID. This is the UID helm/dexaflow/values.yaml pins for the
# migration Job, and the migrations are world-readable, so the Job's
# readOnlyRootFilesystem + drop-ALL posture needs no change.
USER 65532:65532

# The Helm Job and the documented one-off pods pass args only
# (`-path=/migrations -database=... up`), so they are unchanged by the binary's
# new name.
ENTRYPOINT ["/usr/local/bin/dexaflow-migrate"]
CMD ["--help"]
